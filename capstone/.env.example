# Project Aegis-Vision Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Ports
PORT_BACKEND=4000
PORT_AI=8000
PORT_FRONTEND=3000
PORT_RTSP=8554
PORT_REDIS=6379
PORT_POSTGRES=5432

# URLs
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:4000/ws/live
AI_SERVICE_URL=http://localhost:8000
RTSP_STREAM_URL=rtsp://localhost:8554/live

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL / PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=rescue_admin
DB_PASSWORD=rescue_secret_password
DB_NAME=aegis_rescue_db
DATABASE_URL=postgresql://rescue_admin:rescue_secret_password@localhost:5432/aegis_rescue_db?schema=public

# AI Settings
AI_DEVICE=cpu # or 'cuda' for GPU acceleration
MODEL_CONFIDENCE_THRESHOLD=0.55
BYTETRACK_TRACK_THRESH=0.5
BYTETRACK_MATCH_THRESH=0.8
