datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum FixtureStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MarketType {
  ONE_X_TWO
  OVER_UNDER
  BTTS
  DOUBLE_CHANCE
  DRAW_NO_BET
}

enum SettlementStatus {
  PENDING
  WIN
  LOSS
  VOID
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  flag      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leagues League[]

  @@map("countries")
}

model League {
  id         String   @id @default(uuid())
  countryId  String?  @map("country_id")
  name       String
  logo       String?
  externalId String   @unique @map("external_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  country  Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  fixtures Fixture[]

  @@index([countryId])
  @@map("leagues")
}

model Team {
  id         String   @id @default(uuid())
  name       String
  logo       String?
  country    String?
  externalId String   @unique @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  homeFixtures Fixture[]   @relation("HomeTeam")
  awayFixtures Fixture[]   @relation("AwayTeam")
  stats        TeamStats[]
  forms        TeamForm[]
  injuries     Injury[]

  @@map("teams")
}

model Fixture {
  id          String        @id @default(uuid())
  externalId  String        @unique @map("external_id")
  leagueId    String?       @map("league_id")
  homeTeamId  String        @map("home_team_id")
  awayTeamId  String        @map("away_team_id")
  matchDate   String        @map("match_date") // YYYY-MM-DD in UTC
  kickoffTime DateTime      @map("kickoff_time") // UTC Timestamp
  status      FixtureStatus @default(UPCOMING)
  elapsed     String?
  homeScore   Int?          @map("home_score")
  awayScore   Int?          @map("away_score")
  venue       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  league      League?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  homeTeam    Team     @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team     @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  predictions Prediction[]
  odds        Odds[]
  lineups     Lineup[]
  settlements PredictionSettlement[]

  @@index([leagueId, matchDate])
  @@index([matchDate])
  @@index([status])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@map("fixtures")
}

model Prediction {
  id          String           @id @default(uuid())
  fixtureId   String           @map("fixture_id")
  market      MarketType       @default(ONE_X_TWO)
  selection   String // e.g., "1", "X", "2", "Over 2.5", "Yes", "1X"
  confidence  Float // 0 - 100 percentage
  probability Float? // 0.0 - 1.0
  odd         Float?
  isPremium   Boolean          @default(false) @map("is_premium")
  isLocked    Boolean          @default(false) @map("is_locked")
  status      SettlementStatus @default(PENDING)
  source      String           @default("AI_ENGINE") // "AI_ENGINE" | "MOCK" | "EXPERT"
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  fixture    Fixture                @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  settlement PredictionSettlement?

  @@unique([fixtureId, market])
  @@index([fixtureId])
  @@index([isPremium])
  @@index([status])
  @@map("predictions")
}

model Odds {
  id         String     @id @default(uuid())
  fixtureId  String     @map("fixture_id")
  market     MarketType @default(ONE_X_TWO)
  selection  String // "home", "draw", "away", "over", "under"
  odds       Float
  bookmaker  String     @default("Average")
  capturedAt DateTime   @default(now()) @map("captured_at")

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
  @@map("odds")
}

model TeamStats {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  season        String   @default("2024/2025")
  played        Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0) @map("goals_for")
  goalsAgainst  Int      @default(0) @map("goals_against")
  cleanSheets   Int      @default(0) @map("clean_sheets")
  failedToScore Int      @default(0) @map("failed_to_score")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, season])
  @@map("team_stats")
}

model TeamForm {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  form      String // e.g. "WWDWL"
  points    Int      @default(0)
  position  Int?
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId])
  @@map("team_forms")
}

model Injury {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  playerName String   @map("player_name")
  reason     String // e.g., "Hamstring", "Knee", "Suspended"
  status     String   @default("Out") // "Out" | "Doubtful" | "Questionable"
  updatedAt  DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("injuries")
}

model Lineup {
  id        String   @id @default(uuid())
  fixtureId String   @map("fixture_id")
  teamType  String   @map("team_type") // "HOME" | "AWAY"
  formation String? // e.g. "4-3-3", "4-2-3-1"
  startingXl Json     @map("starting_xl") // Array of { name, number, pos }
  bench     Json?    // Array of { name, number, pos }
  createdAt DateTime @default(now()) @map("created_at")

  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, teamType])
  @@map("lineups")
}

model PredictionSettlement {
  id               String           @id @default(uuid())
  predictionId     String           @unique @map("prediction_id")
  fixtureId        String           @map("fixture_id")
  market           MarketType
  selection        String
  actualResult     String           @map("actual_result") // "1", "X", "2", etc.
  settlementStatus SettlementStatus @map("settlement_status") // WIN | LOSS | VOID
  odds             Float?
  confidence       Float?
  homeScore        Int              @map("home_score")
  awayScore        Int              @map("away_score")
  settledAt        DateTime         @default(now()) @map("settled_at")

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  fixture    Fixture    @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId])
  @@index([settlementStatus])
  @@index([settledAt])
  @@map("prediction_settlements")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions      Session[]
  subscriptions Subscription[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("userId")
  token      String    @unique
  deviceName String?   @map("device_name")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  plan      String             @default("PREMIUM_MONTHLY") // "FREE" | "PREMIUM_MONTHLY" | "PREMIUM_ANNUAL"
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now()) @map("started_at")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model ApiUsage {
  id           String   @id @default(uuid())
  date         String   @map("date") // YYYY-MM-DD
  endpoint     String
  requestCount Int      @default(0) @map("request_count")
  dailyLimit   Int      @default(100) @map("daily_limit")
  status       String   @default("OK") // "OK" | "WARNING" | "EXCEEDED"
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([date, endpoint])
  @@index([date])
  @@map("api_usage")
}
