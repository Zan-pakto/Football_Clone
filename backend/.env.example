PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/jolloftips?sslmode=require"
FOOTBALL_PROVIDER="nerdytips"
TIMEZONE_OFFSET="330"
CORS_ORIGIN="http://localhost:3000"
JWT_SECRET="your_secure_jwt_secret_key_minimum_32_characters"

# Optional NerdyTips Scraper Credentials (for VIP/premium predictions)
NERDYTIPS_USERNAME=""
NERDYTIPS_PASSWORD=""

# Optional Fallback Provider (Bzzoiro)
BZZOIRO_API_KEY=""
BZZOIRO_BASE_URL="https://sports.bzzoiro.com/api/v2"

# Payment Provider
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""

