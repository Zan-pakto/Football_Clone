PORT=5000
DATABASE_URL="postgresql://username:password@host:port/database"
JWT_SECRET="jolloftips-super-secure-secret-key-32-chars-minimum"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console
# Authorized JavaScript origins: http://localhost:3000, http://localhost:5000
# Authorized redirect URIs: http://localhost:5000/api/auth/google/callback, http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Payments & Football Providers
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FOOTBALL_PROVIDER="nerdytips"
BZZOIRO_API_KEY=""
BZZOIRO_BASE_URL="https://sports.bzzoiro.com/api/v2"

# ==============================================================================
# EMAIL SERVICE (VIP Purchase Confirmation & Account Notifications)
# ==============================================================================
# OPTION 1: SMTP Server (Recommended for Gmail, Outlook, cPanel, Brevo, SendGrid)
# For Gmail:
#   1. Go to Google Account -> Security -> Enable 2-Step Verification
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Name (e.g., "Jolloftips") and generate a 16-character App Password
#   4. Set SMTP_USER="your-email@gmail.com" and SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Jolloftips VIP <support@jolloftips.com>"

# OPTION 2: Resend API (Alternative to SMTP: https://resend.com)
# If provided, emails will be delivered automatically via Resend API
RESEND_API_KEY=""
